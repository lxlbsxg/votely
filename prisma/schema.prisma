// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAnonymous   Boolean   @default(false)

  accounts   Account[]
  sessions   Session[]
  contents   Content[]
  votes      Vote[]
  voteEvents VoteEvent[]
  profile    UserProfile?

  friendshipsAsUser       Friendship[]         @relation("FriendshipsAsUser")
  friendshipsAsFriend     Friendship[]         @relation("FriendshipsAsFriend")
  groupsOwned             Group[]
  groupMemberships        GroupMember[]
  conversationMemberships ConversationMember[]
  messagesSent            Message[]
  forwardsSent            Forward[]            @relation("ForwardsSent")
  forwardsReceived        Forward[]            @relation("ForwardsReceived")

  createdAt DateTime @default(now())
}

model Content {
  id          String   @id @default(cuid())
  authorId    String
  body        String   @db.Text
  imageUrl    String?
  isPublic    Boolean  @default(true)
  isAnonymous Boolean  @default(false)
  tags        String[] @default([])
  // Claude-extracted { stance, topic, emotion, keywords[] } - see
  // src/lib/analysis.ts. Null until the async analysis call completes.
  analysis    Json?
  assetId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  asset      Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  votes      Vote[]
  voteEvents VoteEvent[]
  forwards   Forward[]

  @@index([authorId])
  @@index([assetId])
  @@index([isPublic, createdAt])
}

enum VoteType {
  SUPPORT
  OPPOSE
  SKIP
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  type      VoteType
  // Set when this vote happened via a forwarded copy of the content, so
  // "attitude change caused by forwarding" can be measured later.
  forwardId String?
  createdAt DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  event   VoteEvent?
  forward Forward?   @relation(fields: [forwardId], references: [id], onDelete: SetNull)

  @@unique([userId, contentId])
}

// Records when a piece of content was shown vs. when the user actually
// voted on it, so response latency can be turned into an RVS score.
model VoteEvent {
  id        String   @id @default(cuid())
  voteId    String   @unique
  userId    String
  contentId String
  shownAt   DateTime
  votedAt   DateTime
  latencyMs Int
  rvs       Float

  vote    Vote    @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Aggregated per-user scoring, recomputed after each vote (see
// src/lib/profileScoring.ts). Not a real behavioral model yet -
// placeholder heuristics until the product's real formulas are provided.
model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emoScore           Float    @default(0)
  stanceBias         Float    @default(0)
  emotionSensitivity Float    @default(0)
  // Top tags (by frequency) among content this user has voted SUPPORT on -
  // drives the Feed recommendation's "similar" bucket.
  interestTags       String[] @default([])
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Minimal mutual friendship: adding a friend creates rows in both
// directions, no request/accept flow (yet).
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendshipsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipsAsFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

// Minimal open groups: owner adds members directly, no invite/accept flow.
model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  conversation Conversation?
  forwards     Forward[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// Unifies 1:1 and group chat. Direct conversations have isGroup=false and
// exactly two ConversationMember rows; group conversations mirror a Group.
model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  groupId   String?  @unique
  createdAt DateTime @default(now())

  group    Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

enum MessageType {
  TEXT
  IMAGE
  FORWARD
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType
  text           String?     @db.Text
  imageUrl       String?
  forwardId      String?     @unique
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  forward      Forward?     @relation(fields: [forwardId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// A single forward event, to a user or a group (exactly one of
// toUserId/toGroupId is set). Recipients' Votes on `content` link back
// here via Vote.forwardId.
model Forward {
  id         String   @id @default(cuid())
  contentId  String
  fromUserId String
  toUserId   String?
  toGroupId  String?
  createdAt  DateTime @default(now())

  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  fromUser User     @relation("ForwardsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User?    @relation("ForwardsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  toGroup  Group?   @relation(fields: [toGroupId], references: [id], onDelete: Cascade)
  message  Message?
  votes    Vote[]

  @@index([contentId])
  @@index([toUserId])
  @@index([toGroupId])
}

enum AssetType {
  STOCK
  CRYPTO
}

// A company/asset homepage subject. `providerId` is what's actually sent to
// the market-data API - the stock ticker for STOCK (same as symbol), or the
// CoinGecko coin slug (e.g. "bitcoin") for CRYPTO, since crypto tickers and
// provider ids differ. Created lazily on first page view (see
// src/lib/actions/asset.ts) rather than needing an admin UI.
model Asset {
  id         String    @id @default(cuid())
  type       AssetType
  symbol     String
  providerId String
  name       String
  createdAt  DateTime  @default(now())

  contents Content[]

  @@unique([type, providerId])
}
